model FinanceImport {
  id             String   @id @default(cuid())
  organizationId String?
  filename       String
  addedCount     Int      @default(0)
  skippedCount   Int      @default(0)
  invalidCount   Int      @default(0)
  addedAmount    Float    @default(0)
