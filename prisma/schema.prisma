}

model FinanceMonthly {
  id               String   @id @default(cuid())
  organizationId   String?
  month            String // 'YYYY-MM'
  collections      Float    @default(0)
  collectionsPrior Float    @default(0)
  collectionsPlan  Float    @default(0)
  salesPlan        Float    @default(0)
  opexBudget       Float    @default(0)
