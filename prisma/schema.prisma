datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // "native" keeps local dev working (Windows); "rhel-openssl-3.0.x" is
  // the engine Azure Functions' Linux runtime needs (this app's server
  // routes run there via Azure Static Web Apps' hybrid Next.js support).
  // Without this, Prisma only ships the binary for whatever machine ran
  // `prisma generate` — which silently breaks every route that touches
  // the database once deployed, since the right engine simply isn't there.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// NOTE on stage/priority/engagement/assignment: these are stored as plain
// strings, NOT Prisma enums, on purpose. The Fabric data audit (Aug 2026,
// Section 16 "Open Items") explicitly flags that Salesforce and Lexatel
// status domain lists are not yet confirmed. Locking these into a strict
// enum before that confirmation would force a schema migration the moment
// real values arrive. Once the status list is confirmed, add validation at
// the API layer (or a CHECK constraint) rather than a hard Prisma enum.

// ===========================================================================
// MULTI-TENANCY (2026-10-23) — Sphaera is becoming a multi-company SaaS
// product, not a single-customer (One Homes) build. Organization is the
// tenant boundary; every customer-data model below carries an
// `organizationId`. It's a plain indexed scalar, not a declared Prisma
// `@relation`, on every child model — same pragmatic pattern this schema
// already uses for hubspotId/salesforceId/supersedesId ("nullable +
// indexed, integrity enforced in app code, not a DB-level FK") — a formal
// relation on all ~30 models would also force a matching back-relation
// array field on Organization for every single one of them, for no real
// benefit here. Enforcement is centralized instead: see
// lib/tenantContext.ts + the Prisma Client Extension in lib/prisma.ts,
// which auto-injects `organizationId` into every query for these models
// when a request has gone through lib/withTenant.ts.
//
// Rollout is intentionally incremental, not a one-shot rewrite of the
// ~321 existing query call sites: the extension is a no-op (behaves
// exactly as before) for any route that hasn't been wrapped in
// withTenant() yet. Only the leads flow + auth are wired in this pass,
// proving the pattern end-to-end; the remaining routes migrate
// mechanically afterward, one `withTenant()` wrap at a time, without
// this ever being a breaking change for the existing single tenant (One
// Homes) in the meantime.
//
// `organizationId` is String? (nullable) during this migration step —
// every existing row is backfilled to the "One Homes" Organization by
// scripts/backfill-organization-id.ts, after which it's flipped to
// required in a follow-up schema push. Same nullable -> backfill ->
// required pattern already used for Lead.email this session.

model Organization {
  id        String   @id @default(cuid())
  name      String
  // URL/invite-link-safe identifier — not used for subdomain routing in
  // this phase (onboarding is invite-link based, not subdomain based,
  // per product decision 2026-10-23), but kept unique now since every
  // invite link embeds it and changing it later would break old links.
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription?
  invites      OrganizationInvite[]

  @@map("organizations")
}

// Billing shape only — no Stripe wiring yet (that's a separate, later
// phase). Exists now so the Organization model and its consumers don't
// need a second schema change when billing is actually built.
model Subscription {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                 String       @default("trial") // trial | starter | pro | enterprise
  status               String       @default("trialing") // trialing | active | past_due | canceled
  stripeCustomerId     String?
  stripeSubscriptionId String?
  seatsLimit           Int?
  currentPeriodEnd     DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@map("subscriptions")
}

// Powers invite-link onboarding (the chosen tenant-onboarding path,
//2026-10-23) — a prospective org admin receives a link containing
// `token`, accepts it via app/api/invites/accept/route.ts, which creates
// their User row scoped to `organizationId` with a hashed password.
model OrganizationInvite {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  token           String       @unique
  // If set, only this exact address can accept the invite. Null = an
  // open/shareable invite link for the org (e.g. a generic "invite your
  // team" link), accepted by whoever has it.
  email           String?
  role            String       @default("AGENT")
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdByUserId String?
  createdAt       DateTime     @default(now())

  @@index([organizationId])
  @@map("organization_invites")
}

model Lead {
  id                   String    @id @default(cuid())
  organizationId       String?
  // Phase 1 Sales Scope — "Unique client ID (UID)": generated once at
  // lead creation, shown to the salesperson, used as the reference across
  // payments and the outbound Onyx handoff, and can never change.
  // Nullable + indexed rather than @unique at the DB level, same reason
  // as salesforceId below — SQL Server rejects multiple NULLs on a plain
  // unique column, which every pre-existing lead would trip before the
  // backfill script runs. Uniqueness is enforced in lib/leadUid.ts via a
  // generate-and-check-for-collision loop.
  uid                  String?
  name                 String
  // The original single "primary contact" field — phone/mobile if either
  // exists, else email (see lib/hubspotContactFilter.ts's `fullName`-style
  // helpers). Kept as-is since search/duplicate-detection/CSV export
  // already depend on it; `email` below is additive, not a replacement.
  contact              String
  // 2026-10-16 — added because `contact` prioritizing phone meant email
  // was invisible in the UI for ~191,128 of ~191,139 HubSpot-imported
  // leads whenever a phone number was also present, even though most of
  // them have a real email in HubSpot. Populated going forward by every
  // sync path (lib/hubspotWebhook.ts, lib/hubspotBulkImport.ts,
  // lib/hubspotSync.ts); backfilled for existing leads by
  // scripts/backfill-lead-emails.ts.
  email                String?
  source               String
  market               String
  projectInterest      String
  stage                String    @default("New")
  score                Int       @default(0)
  engagement           String    @default("Medium")
  priority             String    @default("Medium")
  lastInteractionAt    DateTime?
  nextAction           String?
  nextActionDueAt      DateTime?
  assignment           String    @default("Unassigned")
  // PRD AE08 — set when a lead is claimed (assignment becomes "Locked");
  // released back to the unassigned pool if required activity (a logged
  // call/email/meeting) doesn't happen before this expires. See
  // lib/leadLocks.ts for the release logic and why it's a lazy check
  // rather than a scheduled job.
  lockedUntil          DateTime?
  prioritizationReason String?
  assignedUserId       String?
  assignedUser         User?     @relation(fields: [assignedUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  // Legacy Salesforce lead ID — the live sync that wrote this has been
  // replaced by the HubSpot sync (see lib/hubspotSync.ts), but the field
  // stays so pre-existing Salesforce-synced leads can still be matched by
  // hubspotleadsync via HubSpot's own "salesforceleadid" contact property
  // (this HubSpot portal mirrors the same Salesforce org) rather than
  // being re-created as duplicates. Not @unique at the DB level — SQL
  // Server treats multiple NULLs as a uniqueness violation on a plain
  // unique column; uniqueness is enforced in the sync code via a
  // lookup-before-insert instead.
  salesforceId         String?
  // Real HubSpot sync (see lib/hubspotSync.ts). Null for leads created
  // directly in Sphaera or still only matched via the legacy salesforceId
  // above. Same nullable + indexed pattern as salesforceId, for the same
  // SQL Server multi-NULL-uniqueness reason.
  hubspotId            String?
  lastSyncedAt         DateTime?
  // Real deal figures pulled from Salesforce (Estimated_Value__c /
  // Closed_Value_All__c and Closing_Date__c) — this org tracks deals
  // directly on the Lead rather than a separate Opportunity object (its
  // native Opportunity data is essentially empty). Used to auto-create a
  // real Sphaera Opportunity once a lead's stage reaches deal territory
  // — see lib/leadToOpportunity.ts.
  estimatedValue       Int?
  estimatedCloseAt     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  notes                    LeadNote[]
  timelineEvents           LeadTimelineEvent[]
  opportunities            Opportunity[]
  tags                     LeadTag[]
  duplicateFlagsAsNew      DuplicateLeadFlag[] @relation("DuplicateFlagLead")
  duplicateFlagsAsOriginal DuplicateLeadFlag[] @relation("DuplicateFlagDuplicateOf")

  @@index([organizationId])
  @@index([assignedUserId])
  @@index([salesforceId])
  @@index([hubspotId])
  @@index([uid])
  // Added alongside the /leads list page's server-side pagination +
  // filtering (2026-10-15) — at ~194K rows (post HubSpot bulk import),
  // the previous unindexed `ORDER BY score DESC` plus client-side
  // filtering over the full table was the reason the page hung.
  @@index([score])
  @@index([stage])
  @@index([source])
  @@index([market])
  @@index([projectInterest])
  @@index([nextActionDueAt])
  @@map("leads")
}

model LeadNote {
  id             String   @id @default(cuid())
  organizationId String?
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author         String
  text           String
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([leadId])
  @@map("lead_notes")
}

// Phase 1 Sales Scope — "Interest Tags": added/removed at any lead
// stage, searchable/filterable, with the adding/removing user and
// timestamp retained for audit. Soft-delete (removedAt set, row kept)
// rather than a hard delete IS the audit history here, matching this
// model's own "author as a plain string" precedent (LeadNote above)
// rather than a full User relation.
model LeadTag {
  id             String    @id @default(cuid())
  organizationId String?
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag            String
  addedByName    String
  createdAt      DateTime  @default(now())
  removedAt      DateTime?
  removedByName  String?

  removalRequests TagRemovalRequest[]

  @@index([organizationId])
  @@index([leadId])
  @@index([tag])
  @@map("lead_tags")
}

// Per the boss's direct request (2026-10-13 call): removing a tag is no
// longer instant — the requester must give a reason, an Admin reviews
// it, and only an approval actually soft-deletes the LeadTag. Mirrors
// DuplicateLeadFlag's pending/resolved shape.
model TagRemovalRequest {
  id              String    @id @default(cuid())
  organizationId  String?
  leadTagId       String
  leadTag         LeadTag   @relation(fields: [leadTagId], references: [id], onDelete: Cascade)
  reason          String
  requestedByName String
  status          String    @default("pending") // pending | approved | denied
  resolvedByName  String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([organizationId])
  @@index([leadTagId])
  @@index([status])
  @@map("tag_removal_requests")
}

model LeadTimelineEvent {
  id                  String   @id @default(cuid())
  organizationId      String?
  leadId              String
  lead                Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type                String // call | email | meeting | note | stage_change | task
  // Unbounded: this now holds AI-drafted messages logged as sent (JN08)
  // and note text, either of which can exceed SQL Server's default
  // NVARCHAR(1000) for a plain String column.
  summary             String   @db.NVarChar(Max)
  occurredAt          DateTime @default(now())
  // Set only for rows imported from HubSpot (see lib/hubspotActivitySync.ts)
  // — lets re-running the import skip engagements already pulled in,
  // instead of duplicating the whole timeline on every sync. Null for
  // every Sphaera-native event (notes, calls logged in-app, stage
  // changes, etc.), which already land here through their own routes.
  hubspotEngagementId String?

  @@index([organizationId])
  @@index([leadId])
  @@index([hubspotEngagementId])
  @@map("lead_timeline_events")
}

// Stage set here consolidates PRD AE15's full 10-stage list into 8
// columns for MVP board readability (see components/pipeline/README-level
// comment in lib/pipelineData.ts for the exact mapping). Stored as a plain
// string for the same reason as Lead.stage — status domains aren't
// confirmed yet per the Fabric audit.
model Opportunity {
  id              String    @id @default(cuid())
  organizationId  String?
  leadName        String
  contact         String
  value           Int
  probability     Int
  expectedCloseAt DateTime?
  projectInterest String
  nextAction      String
  stage           String    @default("New")
  lossReason      String?
  leadId          String?
  lead            Lead?     @relation(fields: [leadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedUserId  String?
  assignedUser    User?     @relation(fields: [assignedUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([organizationId])
  @@index([leadId])
  @@index([assignedUserId])
  @@map("opportunities")
}

// AEX (gamification) entities. Tier thresholds live in
// lib/aexTransform.ts as a single configurable constant, explicitly
// flagged as placeholder pending business sign-off (PRD Section 14.3 —
// weights/thresholds/caps must be approved by the One Homes business
// owner before UAT).

// Role is a plain string (not a Prisma enum) because Azure SQL Server
// does not support native enum types (Prisma error P1012 confirmed this
// during setup). The TypeScript-level union type
// ("AGENT" | "MANAGER" | "ADMIN") lives in lib/roles.ts and is enforced
// at the application layer instead. PF02 (Role Based Access Control)
// defines these three tiers for MVP; more granular PRD roles (Booker,
// Commercial Director, Executive) can be added as new string values later
// without a schema migration.

model Team {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  managerId      String?
  manager        User?    @relation("TeamManager", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members        User[]   @relation("TeamMembers")
  targets        Target[]
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@map("teams")
}

model User {
  id             String   @id @default(cuid())
  organizationId String?
  entraId        String?  @unique
  name           String
  email          String
  // Set only for email+password accounts (new, non-Entra orgs) — hashed
  // with bcrypt, see lib/auth.ts's Credentials provider. Null for every
  // Entra ID sign-in (One Homes today), which never uses a password.
  passwordHash   String?
  role           String   @default("AGENT")
  teamId         String?
  team           Team?    @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  managedTeams   Team[]   @relation("TeamManager")
  // Phase 1 Sales Scope Foundations — "No data can be exported unless you
  // [have] specific rights": an explicit, Admin-grantable permission,
  // deliberately separate from role. Being an Admin does not imply this —
  // it must be turned on per user, including for Admins themselves.
  canExportData  Boolean  @default(false)
  // Sphaera Finance module access — same Admin-grantable, role-independent
  // pattern as canExportData above. canAccessFinancePayroll is a separate,
  // stricter flag gating People Costs, salary-category entries, and
  // backup/restore specifically (mirrors the source app's two distinct
  // Entra app-roles, OneHomesDashboard.Access / ...Payroll).
  canAccessFinance        Boolean  @default(false)
  canAccessFinancePayroll Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // PRD AE01 (Sign In and Welcome Sequence) — Agents (not Admins) see a
  // daily "Welcome back" target-review screen before the rest of the
  // app. It re-shows on a genuinely new sign-in (see lib/auth.ts's
  // `signedInAt`, set only when NextAuth's `account` param is present —
  // i.e. an actual sign-in, not a resumed session) OR when the calendar
  // date has rolled over since it was last acknowledged, even if the
  // session was never signed out of. Both fields are written together
  // when the agent clicks "Next".
  lastWelcomeAckDate       DateTime?
  lastWelcomeAckSignedInAt DateTime?

  pointEvents           AexPointEvent[]
  badges                UserBadge[]
  streaks               UserStreak[]
  assignedOpportunities Opportunity[]
  assignedLeads         Lead[]
  documents             Document[]
  tasks                 Task[]
  journalEntries        JournalEntry[]
  mindStateCheckIns     MindStateCheckIn[]
  targets               Target[]
  notifications         Notification[]
  whatsappNumber        WhatsAppNumber?
  janusConversations    JanusConversation[]
  janusFeedback         JanusFeedback[]
  challengesSent        Challenge[]         @relation("ChallengesSent")
  challengesReceived    Challenge[]         @relation("ChallengesReceived")
  playbooksCreated      Playbook[]
  teamFocusesSet        TeamFocus[]
  graphToken            GraphToken?
  projectsCreated       Project[]
  paymentPlansCreated   PaymentPlan[]
  unitsCreated          Unit[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([teamId])
  @@map("users")
}

// Phase 1 Sales Scope — "Sphaera inventory": Sphaera is the operational
// source of truth for sales inventory, not a read model pulled from
// elsewhere. CRO creates/maintains this directly. Gated to ADMIN for now
// (see lib/inventoryData.ts) since Sphaera's role model doesn't have a
// dedicated CRO/Director tier yet — a known simplification, same as
// elsewhere in this build, flagged for a real business decision later.
model Project {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  units        Unit[]
  paymentPlans PaymentPlan[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("projects")
}

model PaymentPlan {
  id             String   @id @default(cuid())
  organizationId String?
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  description    String?  @db.NVarChar(Max)
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt      DateTime @default(now())

  units Unit[]

  @@index([organizationId])
  @@index([projectId])
  @@map("payment_plans")
}

// Status flow per the doc: available | reserved | sold | blocked (CRO).
// A unit can't become "available" without a floor plan — enforced in
// lib/inventoryData.ts, not just the UI, since a proposal must never be
// able to present a unit that doesn't actually meet the requirement.
model Unit {
  id             String       @id @default(cuid())
  organizationId String?
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unitNumber     String
  floor          String?
  unitType       String
  size           Float
  areaBasis      String       @default("sqft")
  price          Int
  currency       String       @default("AED")
  status         String       @default("blocked")
  paymentPlanId  String?
  paymentPlan    PaymentPlan? @relation(fields: [paymentPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  // Document rows (lib/documentsData.ts docType "Floor Plan" / "Unit View")
  // -- reuses the existing PF08 Document/Blob Storage service rather than a
  // separate file-storage mechanism.
  floorPlanDocId String?
  viewsDocId     String?
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([projectId, unitNumber])
  @@index([organizationId])
  @@index([projectId])
  @@map("units")
}

// PRD AV10 — AEX governance config. Was a true singleton row
// (single-tenant) — now one row per organization instead, same pattern
// as WhatsAppConfig. Tier thresholds, Productivity Index weights,
// allocation caps, and the tier-gating/Daily-Club thresholds below are
// all still PLACEHOLDER defaults pending business sign-off (same
// governance note as lib/aexTransform.ts etc.) — the point of this
// table is that an Admin can change them per-org without a code deploy,
// not that the numbers themselves are final.
model AexConfig {
  id                              String   @id @default(cuid())
  organizationId                  String?
  tierSilverMinPoints             Int      @default(500)
  tierGoldMinPoints               Int      @default(2000)
  piWeightSpeedToLead             Float    @default(0.25)
  piWeightOutput                  Float    @default(0.2)
  piWeightEngagementConversion    Float    @default(0.2)
  piWeightInteractionFulfilment   Float    @default(0.2)
  piWeightDataQuality             Float    @default(0.15)
  maxActiveLeadAssignments        Int      @default(15)
  maxActiveOpportunityAssignments Int      @default(15)
  // PRD 14.4 "gated opportunity access" — leads scoring at/above this
  // are visible to everyone but claimable ONLY by Gold-tier agents for
  // goldGateHours after creation, then open to all tiers.
  goldGateScoreThreshold          Int      @default(85)
  goldGateHours                   Int      @default(2)
  // PRD 14.5 Daily Club — real points earned today at/above this
  // threshold qualifies an agent for today's Daily Club.
  dailyClubPointThreshold         Int      @default(50)
  updatedById                     String?
  updatedAt                       DateTime @updatedAt

  @@index([organizationId])
  @@map("aex_config")
}

// PRD AE18 — Playbook / best-practice feed. Deliberately seeded with
// zero rows (no invented playbook content) — Admin/Manager author real
// ones from Admin, Agents read them from the feed.
model Playbook {
  id             String   @id @default(cuid())
  organizationId String?
  title          String
  category       String
  body           String   @db.NVarChar(Max)
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([category])
  @@map("playbooks")
}

// PRD 14.9/14.10 — a real head-to-head AEX challenge between two peers
// over a fixed period, judged on points earned during that window.
// Replaces the earlier cosmetic-only ChallengePicker stub.
model Challenge {
  id             String    @id @default(cuid())
  organizationId String?
  challengerId   String
  challenger     User      @relation("ChallengesSent", fields: [challengerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  opponentId     String
  opponent       User      @relation("ChallengesReceived", fields: [opponentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  metric         String    @default("points") // only metric AEX can currently judge head-to-head
  periodStart    DateTime
  periodEnd      DateTime
  // Pending (awaiting opponent) -> Active (accepted) | Declined, then
  // Active resolves to ChallengerWon | OpponentWon | Draw once periodEnd
  // passes and points earned during the window are compared.
  status         String    @default("Pending")
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  @@index([organizationId])
  @@index([challengerId])
  @@index([opponentId])
}

// PRD JN14 (Explainability and Feedback) — "was this useful?" capture
// for material Janus outputs that aren't already a stored JanusMessage
// (briefing, lead summary, coaching) or don't already have their own
// richer accept/edit/reject flow (Next Best Action, Compose). `context`
// is a free-form tag like "briefing", "leadSummary:<leadId>",
// "coaching", or "command:<messageId>" for a specific chat turn.
model JanusFeedback {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  context        String
  useful         Boolean
  note           String?  @db.NVarChar(Max)
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([context])
}

// Company-level WhatsApp Business Account (WABA) configuration. One row
// per organization — call sites (app/api/whatsapp/connect,verify) still
// need updating to filter by organizationId instead of grabbing whichever
// row exists first; tracked as Phase 2 follow-up per the multi-tenancy
// plan, not done in this pass.
model WhatsAppConfig {
  id              String   @id @default(cuid())
  organizationId  String?
  wabaId          String // WhatsApp Business Account ID from Meta
  metaAppId       String // Meta App ID
  systemUserToken String // Permanent access token (System User)
  businessName    String
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  numbers WhatsAppNumber[]

  @@index([organizationId])
  @@map("whatsapp_configs")
}

// One row per agent's connected WhatsApp Business phone number. Verified
// via Meta's phone-number OTP flow (lib/whatsapp.ts), not a QR-linked
// session — see the build discussion on why QR-based unofficial clients
// were deliberately avoided (ToS / ban risk).
model WhatsAppNumber {
  id             String         @id @default(cuid())
  organizationId String?
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  configId       String
  config         WhatsAppConfig @relation(fields: [configId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  phoneNumber    String         @unique
  phoneNumberId  String         @unique // Meta's internal phone_number_id, needed for send calls
  displayName    String?
  verifiedAt     DateTime?
  createdAt      DateTime       @default(now())

  conversations WhatsAppConversation[]

  @@index([organizationId])
  @@map("whatsapp_numbers")
}

// One conversation per (agent number, client phone number) pair —
// matches how WhatsApp itself groups messages into a single thread per
// contact.
model WhatsAppConversation {
  id             String         @id @default(cuid())
  organizationId String?
  agentNumberId  String
