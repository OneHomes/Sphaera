}

// Reversible-change log (distinct from the app-wide AuditLog, which is a
// flat append-only record) — stores before/after row snapshots so a
// change can be undone with an optimistic-concurrency check (see
// lib/finance/changeJournal.ts). Mirrors the source's `change_journal`.
model FinanceChangeJournal {
  id             String    @id @default(cuid())
  organizationId String?
  auditId        String? // optional cross-reference to AuditLog.id
  action         String
  description    String    @db.NVarChar(Max)
  actorId        String
  actorEmail     String
  beforeJson     String    @db.NVarChar(Max) // array of {table,id,row}
  afterJson      String    @db.NVarChar(Max)
  changedAt      DateTime  @default(now())
  undoneAt       DateTime?
  undoneBy       String?

  @@index([organizationId])
  @@map("finance_change_journal")
}

model FinancePaymentSource {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  kind           String // Bank account | Company card | Other
  legalEntity    String?
  institution    String?
  currency       String?
  lastFour       String?
  note           String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  paymentTraces        FinancePaymentTrace[]
  creditInvoices       FinanceCreditInvoice[]
  creditRecurring      FinanceCreditRecurring[]
  creditCardRules      FinanceCreditCardRule[]
  creditBankLink       FinanceCreditBankLink?
  treasuryBankAccounts FinanceBankAccount[]

  @@unique([organizationId, name])
  @@map("finance_payment_sources")
}

model FinanceSubscription {
  id              String   @id @default(cuid())
  organizationId  String?
  supplier        String
  service         String
  purpose         String?
  department      String?
  costHead        String?
  owner           String?
  billingCycle    String?
