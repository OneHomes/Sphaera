model FinanceErpSyncStaging {
  id                   String              @id @default(cuid())
  organizationId       String?
  receivedAt           DateTime            @default(now())
  externalId           String
  rawJson              String              @db.NVarChar(Max)
  matchedTransactionId String?
  matchedTransaction   FinanceTransaction? @relation(fields: [matchedTransactionId], references: [id], onDelete: SetNull)
  status               String              @default("pending") // pending | matched | ignored
  sourceId             String
