  clientPhone    String
  clientName     String?
  leadId         String?
  lastMessageAt  DateTime       @default(now())
  createdAt      DateTime       @default(now())

  messages WhatsAppMessage[]

  @@unique([agentNumberId, clientPhone])
  @@index([organizationId])
  @@index([agentNumberId])
  @@map("whatsapp_conversations")
}

model WhatsAppMessage {
  id             String               @id @default(cuid())
  organizationId String?
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String // "inbound" | "outbound"
  content        String
  metaMessageId  String? // Meta's own message id, for delivery/read status correlation
  status         String               @default("sent") // sent | delivered | read | failed
  createdAt      DateTime             @default(now())

  @@index([organizationId])
  @@index([conversationId])
  @@map("whatsapp_messages")
}

model AexPointEvent {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label          String
  points         Int
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("aex_point_events")
}

model UserBadge {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String
  earnedAt       DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("aex_user_badges")
}

model UserStreak {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label          String
  currentCount   Int      @default(0)
  resetRule      String
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@map("aex_user_streaks")
}

// PF07 (Audit Trail) requirement: permission and role changes must be
// logged with actor, timestamp, and before/after context.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String
  actorEmail     String
  action         String
  targetId       String?
  details        String
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@map("audit_logs")
}

// PF08 (Document Service). Actual file bytes live in Azure Blob Storage
// (see lib/blobStorage.ts) — this table stores only metadata + the blob
// name needed to fetch/delete the real file. relatedTo is a free-text
// field (not a strict Lead/Opportunity foreign key) matching how the
// original mock data modeled it, to keep this MVP simple; tightening it
// into a real relation is a reasonable future enhancement.
model Document {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  blobName       String
  contentType    String
  sizeBytes      Int
  docType        String   @default("Brochure")
  relatedTo      String?
  uploadedById   String
  uploadedBy     User     @relation(fields: [uploadedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt      DateTime @default(now())
  // Phase 1 Sales Scope — "Janus company knowledge": extracted at upload
  // time (lib/documentTextExtraction.ts) so Janus can ground answers in
  // the actual content, not just the file's existence. Null for formats
  // extraction doesn't support yet (images, .docx, .pptx) -- those
  // documents still upload/browse fine, they're just not usable as
  // Janus grounding material.
  extractedText  String?  @db.NVarChar(Max)

  // Doc: "An authorised content owner must be able to add, replace and
  // retire documents." Replacing uploads a new version row (supersedesId
  // points at the one it replaces) and retires the old one — neither
  // action hard-deletes, so the version chain is real history, and
  // Janus/active listings only ever see status "active" so a superseded
  // payment plan can never get cited as current truth.
  status       String     @default("active") // active | retired
  version      Int        @default(1)
  // Not @unique at the DB level — SQL Server rejects multiple NULLs on a
  // plain unique column (hit this exact issue before with salesforceId
  // and uid). One-document-per-supersession is enforced in the replace
  // route instead (only ever set once, at creation, never updated).
  supersedesId String?
  supersedes   Document?  @relation("DocumentVersionChain", fields: [supersedesId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  // Prisma requires a list here since supersedesId isn't DB-unique (see
  // above) — in practice this is always 0 or 1 entries, enforced by the
  // replace route only ever setting supersedesId once, at creation.
  supersededBy Document[] @relation("DocumentVersionChain")

  @@index([organizationId])
  @@index([uploadedById])
  @@index([status])
  @@index([supersedesId])
  @@map("documents")
}

// PRD AE14 — task sources: user created, manager assigned, Janus
// proposed, conversation generated, rule generated, stage requirement.
// createdById is a plain string (not a relation) to record who
// created/assigned the task without a second User FK — avoids the same
// multi-relation cascade complexity we hit with Team/Opportunity earlier.
model Task {
  id             String    @id @default(cuid())
  organizationId String?
  title          String
  relatedTo      String?
  leadId         String?
  dueAt          DateTime?
  completed      Boolean   @default(false)
  source         String    @default("User created")
  assignedToId   String
  assignedTo     User      @relation(fields: [assignedToId], references: [id], onDelete: Cascade)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([assignedToId])
  @@map("tasks")
}

// PRD 4.10 / 19.5 — Journal entries are strictly private to their
// author. Unlike every other entity in this schema, there is NO
// Manager/Admin override in the API layer for this one — access is
// always author-only, by design.
model JournalEntry {
  id             String    @id @default(cuid())
  organizationId String?
  authorId       String
  author         User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  folder         String    @default("Work")
  title          String
  // Unbounded: rich-text HTML from the journal editor (incl. inline
  // images as data URIs) easily exceeds SQL Server's default
  // NVARCHAR(1000) for a plain String column.
  body           String    @db.NVarChar(Max)
  isFavorite     Boolean   @default(false)
  archivedAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([authorId])
  @@map("journal_entries")
}

// PRD AV04 (Target Tracker) — a target belongs to EITHER a user
// (personal target) OR a team (whole-team target), not both — enforced
// at the application layer, not a DB constraint, to keep this simple.
// Metric is a plain string (not an enum) for the same reason as
// Lead.stage — new metric types can be added without a schema
// migration; calculation logic per metric lives in lib/targetTracker.ts.
// PRD AE03 / 4.10 / 19.5 — MindState check-in. Strictly private like
// JournalEntry: raw entries (mood + optional note) are never exposed to
// Manager/Admin in any API route in this pass. The PRD's "management
// sees an aggregated trend only" requirement (AV15) is a separate,
// not-yet-built aggregation view — deliberately not implemented here to
// PRD JN13 (Janus Memory). Scoped to the persistent Ask interface
// (JN01/JN02) — meeting-prep, the daily briefing, and the message
// composer are one-shot generations by nature, not something a user
// continues as a conversation, so they don't thread through this. Only
// "recent conversation context" from the JN13 memory-category list is
// implemented here; company terminology/playbooks/user-preference memory
// are a separate, not-yet-built layer.
model JanusConversation {
  id             String         @id @default(cuid())
  organizationId String?
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  messages       JanusMessage[]

  @@index([organizationId])
  @@index([userId])
  @@map("janus_conversations")
}

model JanusMessage {
  id             String            @id @default(cuid())
  organizationId String?
  conversationId String
  conversation   JanusConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  // Unbounded: a grounded Janus answer (briefing/ask) routinely exceeds
  // SQL Server's default NVARCHAR(1000) for a plain String column — this
  // is what actually broke first.
  content        String            @db.NVarChar(Max)
  createdAt      DateTime          @default(now())

  @@index([organizationId])
  @@index([conversationId])
  @@map("janus_messages")
}

// avoid a half-finished access-control surface for sensitive wellbeing
// data; only the private capture side ships in this pass.
model MindStateCheckIn {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moodScore      Int // 1 (struggling) .. 5 (great)
  mood           String // human label for moodScore, kept alongside for display without a lookup table
  note           String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("mindstate_checkins")
}

model Target {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teamId         String?
  team           Team?    @relation(fields: [teamId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  metric         String // "revenue" | "calls" | "meetings"
  periodStart    DateTime
  periodEnd      DateTime
  targetValue    Float
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@index([teamId])
  @@map("targets")
}

// PRD PF05 / AE22 — Notifications. Wired to concrete, in-code events
// (lead/opportunity/task assignment, new WhatsApp message, challenge
// updates) that fire during a real API request. Threshold-crossing
// notifications (e.g. "risk became critical") are handled lazily on-read
// from lib/riskCentre.ts, the same pattern used for lead locks and
// challenge resolution elsewhere in this build, since there's no
// background cron in this serverless architecture (see that file for the
// de-dup approach — a true scheduled job, e.g. an Azure Functions Timer
// Trigger, would let this fire even when nobody has the app open, which
// this on-read approach can't).
model Notification {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // lead_assigned | opportunity_assigned | task_assigned | whatsapp_message | challenge_update | risk_critical
  title          String
  body           String
  href           String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("notifications")
}

// PRD JN12 — Prompt Based Focus Orchestration ("Janus, shift the team's
// focus to X"). Scoped to real data Sphaera already has (market, project,
// or source) rather than true ad-campaign data, which needs the
// still-missing Fabric/OneLake pipeline. A focus is proposed by Janus
// (see app/api/janus/focus-proposal) and only becomes a real row here
// once a Manager/Admin explicitly confirms it (PRD: "Janus must not
// silently change allocation, targets, or campaign focus from an
// ambiguous prompt") — see app/api/focus/route.ts.
model TeamFocus {
  id             String   @id @default(cuid())
  organizationId String?
  setById        String
  setBy          User     @relation(fields: [setById], references: [id], onDelete: Cascade)
  teamId         String? // null = company-wide (Admin only)
  dimension      String // "market" | "projectInterest" | "source"
  value          String // e.g. "AED", "Diyar", "Referral"
  reason         String
  startsAt       DateTime @default(now())
  endsAt         DateTime
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([teamId])
  @@index([endsAt])
  @@map("team_focuses")
}

// Real fix for an HTTP 431 ("Request Header Fields Too Large") hit in
// production: the Graph access + refresh tokens used to live directly on
// the NextAuth JWT, which gets encrypted into the session cookie on every
// request. Microsoft Graph tokens for this many scopes (Mail, Calendar,
// Online Meetings, Transcripts) are large, and the accumulated cookie
// size eventually exceeded the server's header-size limit. Storing them
// here instead keeps the session cookie small and fixed-size — see
// lib/graphTokenStore.ts for the read/refresh/write logic, and
// lib/auth.ts's session() callback for how callers still get a plain
// `session.accessToken` with no change to their own code.
model GraphToken {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken    String   @db.NVarChar(Max)
  refreshToken   String   @db.NVarChar(Max)
  expiresAt      DateTime
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@map("graph_tokens")
}

// Phase 1 Sales Scope — "Detect likely duplicates and provide an
// authorised resolution process so communication history and AEX
// events remain attached to the correct record." Flags, never blocks —
// a real-time sync (Salesforce/HubSpot) shouldn't fail because of a
// possible duplicate, a Manager/Admin reviews and resolves it after.
model DuplicateLeadFlag {
  id             String    @id @default(cuid())
  organizationId String?
  leadId         String
  lead           Lead      @relation("DuplicateFlagLead", fields: [leadId], references: [id], onDelete: Cascade)
  duplicateOfId  String
  duplicateOf    Lead      @relation("DuplicateFlagDuplicateOf", fields: [duplicateOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  matchReason    String
  status         String    @default("pending") // pending | merged | dismissed
  resolvedByName String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@index([leadId])
  @@index([duplicateOfId])
  @@index([status])
  @@map("duplicate_lead_flags")
}

// Sphaera Market Intelligence — Pakistan asking-price benchmarks module
// handed over by the boss's team (Cloudflare D1 + Drizzle originally).
// Same three-table shape, ported onto our own Azure SQL via Prisma per
// request so this runs on our database rather than a separate D1 store.
