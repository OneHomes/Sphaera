// customer data (see the multi-tenancy plan's note on this).
model IntelligenceDataset {
  key       String   @id // "snapshot" | "index" | "forecast"
  version   String
  payload   String   @db.NVarChar(Max) // full JSON payload
  updatedAt DateTime

  @@map("intelligence_datasets")
}

model MarketObservation {
  id          String @id
  city        String
  area        String
  segment     String // houses | flats | residential_plots | commercial_plots
  purpose     String // buy | rent
  period      String // YYYY-MM
  price       BigInt // some luxury/commercial asking prices exceed SQL Server's int32 range
  ppsf        Int?
  retrievedAt String
  sourceUrl   String
  source      String
  basis       String

  @@index([city, segment, purpose, period])
  @@map("market_observations")
}

model IndexSeries {
  id      String @id
  city    String
  area    String
  segment String
  purpose String
  size    String
  payload String @db.NVarChar(Max) // full JSON series, including all points

  @@index([city, segment, purpose, size])
  @@map("index_series")
}

// ===========================================================================
// SPHAERA FINANCE (2026-10-26) — ported from the standalone "Sphaera
// Finance" Python/SQLite tool (One Homes overhead/cost-allocation,
// treasury, credit-cycle, merchant-reconciliation, financial-planning).
// A generic Sphaera product feature, not hardcoded to One Homes — every
// model is tenant-scoped exactly like the rest of the app (organizationId
// added to TENANT_SCOPED_MODELS in lib/prisma.ts, including pure child/
// junction tables, per this schema's own established multi-tenancy
// principle above: every table filterable by organizationId on its own,
// never relying on a join being present). Money amounts are Float (USD),
// matching the source SQLite REAL columns exactly — a direct port, not a
// precision redesign. File attachments (invoices, budget XLSX) reuse the
// existing Document model + lib/blobStorage.ts rather than local BLOB
// columns — see documentId fields below. The source's flat `audit` table
// is NOT re-ported; Finance mutations use the existing AuditLog/logAudit
// instead. `change_journal` IS ported (FinanceChangeJournal) since its
// before/after-snapshot undo mechanic is genuinely distinct functionality.
// ===========================================================================

model FinanceTransaction {
  id             String   @id @default(cuid())
  organizationId String?
  fingerprint    String
  occurrence     Int      @default(1)
  month          String // 'YYYY-MM'
  paymentDate    DateTime
  description    String   @db.NVarChar(Max)
  originalCentre String?
  originalHead   String?
  country        String?
  amountUsd      Float
  sourceSheet    String?
  sourceRow      Int?
  sourceFile     String?
  reviewGroup    String   @default("Routine")
  importedAt     DateTime @default(now())

  allocation             FinanceAllocation?
  disputedCharge         FinanceDisputedCharge?
  paymentTrace           FinancePaymentTrace?
  paymentCostSplit       FinancePaymentCostSplit?
  overheadOverride       FinanceOverheadPaymentOverride?
  merchantReview         FinanceMerchantReview?
  personCostAllocations  FinancePersonCostAllocation[]
  merchantInvoiceLinks   FinanceMerchantInvoiceLink[]
  erpStagingMatches      FinanceErpSyncStaging[]

  @@unique([organizationId, fingerprint, occurrence])
  @@index([organizationId, month])
  @@index([organizationId, originalHead, originalCentre])
  @@map("finance_transactions")
}

model FinanceAllocation {
  id             String             @id @default(cuid())
  organizationId String?
  transactionId  String             @unique
  transaction    FinanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  head           String?
  centre         String?
  department     String?
  costHead       String?
  debtPeriod     String             @default("current") // current | 2024-25 | older
  reviewed       Boolean            @default(false)
  note           String?            @db.NVarChar(Max)
  updatedAt      DateTime           @updatedAt

  @@index([organizationId])
  @@map("finance_allocations")
}

model FinanceLegacyMapping {
  id             String   @id @default(cuid())
  organizationId String?
  legacyHead     String
  legacyCentre   String
  department     String?
  costHead       String?
  source         String   @default("suggested")
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, legacyHead, legacyCentre])
  @@map("finance_legacy_mappings")
}

model FinanceManagementDepartment {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  createdAt      DateTime @default(now())

  @@unique([organizationId, name])
  @@map("finance_management_departments")
}

model FinanceManagementCostHead {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  createdAt      DateTime @default(now())

  @@unique([organizationId, name])
  @@map("finance_management_cost_heads")
}

model FinanceCostHead {
  id             String @id @default(cuid())
