# Copy this file to .env.local and fill in real values.
# Get these three from your Entra ID App Registration — see ENTRA_ID_SETUP.md

AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# NextAuth needs its own secret to sign session tokens.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Local dev value shown below. In Azure Web App, set this to your real
# deployed URL, e.g. https://sphaera-onehomes.azurewebsites.net
NEXTAUTH_URL=http://localhost:3000
